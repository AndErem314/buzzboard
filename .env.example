# BuzzBoard configuration — copy to .env and edit
# All paths are relative to project root unless absolute.

# ── Directories ─────────────────────────────────────────────────────────────

# Voice memos land here (relative to project root or absolute path)
BUZZBOARD_INBOX_DIR=inbox

# Pipeline artifacts (JSON handoffs between agents)
BUZZBOARD_PIPELINE_DIR=pipeline

# Processed audio moved here after successful pipeline run
BUZZBOARD_ARCHIVE_DIR=archive

# Obsidian vault path (REQUIRED for Storage Agent)
BUZZBOARD_OBSIDIAN_VAULT=

# Kanban SQLite database path
BUZZBOARD_KANBAN_DB=pipeline/kanban.db

# ── Models ──────────────────────────────────────────────────────────────────

# Ollama model for Editor + Extractor agents
# 16GB RAM: llama3.2:3b  (~2GB)
# 48GB RAM: llama3.1:8b  (~5GB)
BUZZBOARD_OLLAMA_MODEL=llama3.1:8b

# Ollama API host (use host.docker.internal for Docker)
BUZZBOARD_OLLAMA_HOST=http://localhost:11434

# Whisper model: tiny, base, small, medium, large
# tiny (~0.5GB) / base (~1GB) / small (~2GB) / medium (~5GB) / large (~10GB)
# medium recommended for M4 Pro (48GB): ~7% WER vs 12% for base
BUZZBOARD_WHISPER_MODEL=medium

# Whisper backend: whisper (Python) or whisper-cpp (CLI, faster on M-series)
BUZZBOARD_WHISPER_BACKEND=whisper
